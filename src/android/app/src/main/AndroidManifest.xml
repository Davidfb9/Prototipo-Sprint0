<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ................................................................. -->
    <!-- permisos de red: hacen falta para llamar a la API REST -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- ................................................................. -->
    <!-- PERMISOS DE BLUETOOTH LE POR VERSIONES DE ANDROID                -->
    <!--                                                                -->
    <!-- ATENCION 1: en BLUETOOTH_SCAN NO se pone la bandera             -->
    <!--             android:usesPermissionFlags="neverForLocation"      -->
    <!--                                                                -->
    <!--             Esa bandera le dice a Android "no uso el BLE para   -->
    <!--             localizacion", asi que el sistema ELIMINA de los    -->
    <!--             resultados todo anuncio que sirva para ubicar... y  -->
    <!--             los iBeacon de Apple (0x004C) son exactamente eso.  -->
    <!--             Con la bandera puesta el beacon es INVISIBLE.       -->
    <!--                                                                -->
    <!-- ATENCION 2: ACCESS_FINE_LOCATION NO lleva maxSdkVersion,        -->
    <!--             tambien en Android 12 en adelante.                  -->
    <!--                                                                -->
    <!--             Es la contrapartida de no usar neverForLocation.    -->
    <!--             Sin ese permiso Android 12+ registra el escaner     -->
    <!--             bien (status=0) pero descarta TODOS los resultados  -->
    <!--             en silencio. Y ademas el GPS del movil tiene que    -->
    <!--             estar ENCENDIDO.                                    -->
    <!-- ................................................................. -->

    <!-- Android 11 (API 30) y anteriores -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- localizacion: NECESARIA en todas las versiones para escanear BLE -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 12 (API 31) en adelante. Sin neverForLocation. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ................................................................. -->
    <!-- permisos del servicio de primer plano: mantiene el escaneo vivo  -->
    <!-- aunque la app pase a segundo plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Android 13 (API 33) en adelante: para que se vea la notificacion -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PruebaRest1"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <!-- ............................................................. -->
        <!-- servicio de primer plano: mantiene el escaneo del beacon      -->
        <!-- vivo en segundo plano, con una notificacion permanente        -->
        <service
            android:name=".ServicioEscaneoBeacon"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
